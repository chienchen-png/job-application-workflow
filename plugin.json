{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "job-application-workflow",
  "version": "0.4.1",
  "description": "以中文资料库为基础，完成环境检查、岗位调研、网申填写和进度记录。",
  "license": "MIT",
  "author": { "name": "chienchen-png", "url": "https://github.com/chienchen-png" },
  "homepage": "https://github.com/chienchen-png/job-application-workflow",
  "repository": "https://github.com/chienchen-png/job-application-workflow",
  "keywords": ["求职", "网申", "岗位调研", "招聘来源", "ATS", "BOSS直聘", "job-application", "career", "agent-skills", "codex"],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/环境配置/SKILL.md",
      "requires_local_executor": true,
      "interface": {
        "displayName": "Job Application Workflow",
        "shortDescription": "维护一份资料，聚合岗位来源并辅助完成网申",
        "longDescription": "将资料管理、多来源岗位调研、网申填写和进度记录整合为一个中文 Codex 插件。来源注册表覆盖官方招聘站、公开 ATS、学校就业网、公众号与 BOSS直聘；浏览器使用 Edge Control MCP、edge-browser-ops 与 Edge 扩展直连现有浏览器，通过后台 DOM/CDP 执行且不持续占用屏幕焦点，兼容 Windows。",
        "category": "Productivity",
        "developerName": "chienchen-png",
        "websiteURL": "https://github.com/chienchen-png/job-application-workflow",
        "supportURL": "https://github.com/chienchen-png/job-application-workflow/issues",
        "capabilities": ["中文资料管理", "多来源岗位调研", "公开 ATS 查询", "网申填写与回读", "投递进度记录"],
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg",
        "defaultPrompt": ["帮我准备并推进求职投递，先检查环境和资料。", "按我的资料和意向聚合官方、ATS、校园与招聘平台岗位，给出简洁建议。", "填写已确认的申请，清洗解析内容并停在提交前。"]
      }
    }
  }
}
